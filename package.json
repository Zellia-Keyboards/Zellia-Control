{
  "name": "zellia-control",
  "version": "0.2.0",
  "description": "Configurator for Zellia Hall Effect keyboards (React PWA)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:mqjs": "bash vendor/mqjs/build.sh",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "parity": "node scripts/parity/run.mjs",
    "parity:baseline": "node scripts/parity/prepare-baseline.mjs",
    "parity:capture": "playwright test --project=parity",
    "parity:compare": "node scripts/parity/compare.mjs",
    "validate": "tsc -b && eslint . && prettier --check . && vitest run && vite build"
  },
  "dependencies": {
    "@ijprest/kle-serial": "^0.15.1",
    "chart.js": "4.4.9",
    "chartjs-plugin-zoom": "2.2.0",
    "lucide-react": "0.511.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "semver": "^7.8.5",
    "tinycolor2": "1.6.0",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.7.1",
    "@types/tinycolor2": "^1.4.6",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "4.1.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "@tailwindcss/oxide@4.1.10": true,
    "esbuild@0.28.2": true
  }
}
